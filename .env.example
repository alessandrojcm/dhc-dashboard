################################################################################
# DHC Dashboard environment
################################################################################
#
# Copy this file to `.env` at the repository root. mise loads that file for all
# tasks, and apps/web/vite.config.ts uses the repository root as Vite's envDir.
#
# The standard local stack does not need database credentials in this file:
# `docker compose up -d db` and the Phoenix mise tasks agree on
# postgres://postgres:postgres@localhost:54322/postgres.
#
# Keep optional values commented out rather than assigning an empty value. Some
# runtime configuration treats an empty variable as configured.

################################################################################
# Local SvelteKit -> Phoenix connectivity
################################################################################

# Browser requests cannot use the production same-origin /api fallback while
# SvelteKit and Phoenix run on separate local ports.
PUBLIC_API_BASE_URL=http://localhost:4000/api

# Server-side SvelteKit requests already default to this value. It is included
# explicitly so the local topology is clear and can be overridden when needed.
API_BASE_URL=http://localhost:4000/api

# Realtime notification socket. Leave unset to disable the browser socket.
PUBLIC_PHOENIX_SOCKET_URL=ws://localhost:4000/socket

# Phoenix defaults to http://localhost:5173 in development.
# APP_URL=http://localhost:5173

# Phoenix development already allows the usual localhost Vite origins. Override
# with a comma-separated list only for a different frontend origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

################################################################################
# Optional local database override
################################################################################

# DATABASE_URL takes precedence over the individual POSTGRES_* values. Do not
# set it for the standard Docker + mise workflow described above.
# DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=54322
# POSTGRES_DB=postgres

################################################################################
# Authentication and Discord
################################################################################

# Required to exercise Discord OAuth. Register this callback with Discord:
# http://localhost:4000/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Optional notification webhook used by Phoenix jobs.
# DISCORD_WEBHOOK_URL=

################################################################################
# Transactional email (Loops)
################################################################################

# Development delivers email jobs to the local Mailpit container
# (docker-compose `mailpit` service, web UI at http://localhost:8025) as plain
# JSON payloads. Production needs the API key and real dashboard-generated
# transactional IDs for enabled workflows.
# LOOPS_API_KEY=
# INVITE_MEMBER_TRANSACTIONAL_ID=
# WORKSHOP_ANNOUNCEMENT_TRANSACTIONAL_ID=
# WORKSHOP_REGISTRATION_TRANSACTIONAL_ID=
# WORKSHOP_REGISTRATION_ERROR_TRANSACTIONAL_ID=
# MAGIC_LINK_TRANSACTIONAL_ID=

# Optional overrides for the dev Mailpit relay (defaults match the compose
# service).
# MAILPIT_HOST=localhost
# MAILPIT_PORT=1025

################################################################################
# Stripe
################################################################################

# Phoenix Stripe API and webhook credentials. Use test-mode values locally.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
# STRIPE_API_URL=https://api.stripe.com
# STRIPE_MEMBERSHIP_MONTHLY_LOOKUP_KEY=standard_membership_fee
# STRIPE_MEMBERSHIP_ANNUAL_LOOKUP_KEY=annual_membership_fee

# Publishable key used by browser-side Stripe code.
# PUBLIC_STRIPE_KEY=pk_test_...

################################################################################
# Optional application services
################################################################################

# Workshop description generator.
# GROQ_API_KEY=

# Sentry is inactive when no DSN is supplied. SENTRY_AUTH_TOKEN is a build-time
# token for uploading SvelteKit source maps; it is not exposed to the browser.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=
# VITE_PUBLIC_SENTRY_ENABLED=true
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_LOGS_LEVEL=info

################################################################################
# Phoenix production runtime
################################################################################

# Required for a production release. The Fly deployment receives application
# secrets from the fnox production profile rather than a checked-in `.env`.
# PHX_SERVER=true
# DATABASE_URL=ecto://USER:PASSWORD@HOST/DATABASE
# SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
# AUTH_SESSION_DOMAIN=.example.com
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Public deployment addresses and origin policy.
# PHX_HOST=api.example.com
# APP_URL=https://dashboard.example.com
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com
# DISCORD_REDIRECT_URI=https://api.example.com/api/auth/discord/callback

# Optional release/database tuning.
# PORT=4000
# POOL_SIZE=10
# ECTO_IPV6=true
# DNS_CLUSTER_QUERY=
# INVITATION_VERIFICATION_TOKEN_SALT=

################################################################################
# Deployment tooling (not application runtime)
################################################################################

# Required only when deploying Phoenix with `mise run phx-fly-deploy`.
# FLY_API_TOKEN=
# FLY_APP=dhc-dashboard

# Set OP_SERVICE_ACCOUNT_TOKEN as a Fly secret, not in this local file. It is the
# bootstrap credential fnox uses to load production runtime secrets from
# 1Password.
# OP_SERVICE_ACCOUNT_TOKEN=ops_...

# E2E_SERVER, E2E_API_PORT, E2E_COMPOSE_PROJECT, E2E_HARNESS_KEY, MIX_ENV,
# MIX_BUILD_PATH, and the E2E API URLs are task-owned in .mise.toml; do not add
# them here for normal development.
