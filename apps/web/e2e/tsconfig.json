{
	// Type-checks the Playwright suite. `svelte-check` (pnpm check) only covers
	// `src/` via the generated .svelte-kit/tsconfig.json includes, so this config
	// inherits the same compiler options and replaces `include` with e2e/.
	// Run via `pnpm check:e2e` (part of `pnpm check`).
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node", "@playwright/test"]
	},
	"include": ["./**/*.ts", "../playwright.config.ts"],
	"exclude": ["../node_modules/**"]
}
