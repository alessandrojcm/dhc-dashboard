{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["../../.oxlintrc.json"],
	"env": {
		"browser": true,
		"node": true,
		"svelte": true
	},
	"ignorePatterns": [
		".cloudflare/**",
		".svelte-kit/**",
		"build/**",
		"playwright-report/**",
		"test-results/**"
	],
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.spec.ts", "e2e/**/*.ts"],
			"env": {
				"vitest": true,
				"node": true
			}
		}
	]
}
