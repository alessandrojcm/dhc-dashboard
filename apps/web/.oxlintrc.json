{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["../../.oxlintrc.json"],
	"env": {
		"browser": true,
		"node": true,
		"svelte": true
	},
	"ignorePatterns": [
		".cloudflare/**",
		".svelte-kit/**",
		"build/**",
		"playwright-report/**",
		"test-results/**"
	],
	"overrides": [
		{
			"files": ["**/*.test.ts", "**/*.spec.ts", "e2e/**/*.ts"],
			"env": {
				"vitest": true,
				"node": true
			}
		},
		{
			"files": [
				"src/routes/dashboard/training-announcements/**",
				"src/lib/components/training-announcements/**",
				"src/lib/training-announcements/**"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"**/components/workshops",
									"**/components/workshops/*"
								],
								"message": "Training Announcements is not a Workshop. ADR 0026 keeps the two domains apart; only the calendar stylesheet in $lib/components/calendar is shared (docs/ale-311-training-announcements-boundary.md)."
							},
							{
								"group": [
									"**/routes/dashboard/workshops",
									"**/routes/dashboard/workshops/*"
								],
								"message": "Training Announcements is not a Workshop. Build the component under $lib/components/training-announcements instead."
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/routes/dashboard/beginners-workshop/**",
				"src/routes/dashboard/my-beginners-workshops/**",
				"src/routes/(public)/beginners/**",
				"src/lib/beginners-workshops/**",
				"src/lib/components/beginners-workshops/**",
				"src/lib/server/beginners-workshops/**",
				"src/lib/schemas/beginnersWorkshop*",
				"src/lib/schemas/beginnersIntake*"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"**/components/workshops",
									"**/components/workshops/**",
									"**/components/workshop-form*",
									"**/dashboard/workshops",
									"**/dashboard/workshops/**",
									"**/dashboard/my-workshops",
									"**/dashboard/my-workshops/**",
									"**/(public)/workshops",
									"**/(public)/workshops/**",
									"../workshops",
									"../workshops/**",
									"../my-workshops",
									"../my-workshops/**",
									"**/schemas/workshop*",
									"**/server/api/workshop-*",
									"**/server/api/external-workshop-*",
									"**/server/workshop-generator*"
								],
								"message": "A Beginners' Workshop is not a Workshop. ADR 0029 keeps the two apart; build it under the beginners-workshop route or $lib/beginners-workshops instead."
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/lib/components/workshops/**",
				"src/lib/components/workshop-form*",
				"src/routes/dashboard/workshops/**",
				"src/routes/dashboard/my-workshops/**",
				"src/routes/(public)/workshops/**",
				"src/lib/schemas/workshop*",
				"src/lib/server/api/workshop-*",
				"src/lib/server/api/external-workshop-*",
				"src/lib/server/workshop-generator*"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"**/beginners-workshop",
									"**/beginners-workshop/**",
									"**/beginners-workshops",
									"**/beginners-workshops/**",
									"**/my-beginners-workshops",
									"**/my-beginners-workshops/**",
									"**/(public)/beginners",
									"**/(public)/beginners/**",
									"**/schemas/beginnersWorkshop*",
									"**/schemas/beginnersIntake*"
								],
								"message": "A Workshop is not a Beginners' Workshop. ADR 0029 keeps the two apart."
							}
						]
					}
				]
			}
		}
	]
}
