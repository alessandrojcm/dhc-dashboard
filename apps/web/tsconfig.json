{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": [
			"$app/types",
			"./worker-configuration.d.ts",
			"node"
		],
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts"
	],
	"exclude": ["src/service-worker"]
}
