{
	"name": "dhc-dashboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @dhc/web dev",
		"build": "pnpm --filter @dhc/web build",
		"preview": "pnpm --filter @dhc/web preview",
		"check": "pnpm --filter @dhc/web check",
		"check:watch": "pnpm --filter @dhc/web check:watch",
		"eval:dev": "pnpm --filter @dhc/web eval:dev",
		"test:unit": "pnpm --filter @dhc/web test:unit",
		"test": "pnpm --filter @dhc/web test",
		"test:e2e": "pnpm --filter @dhc/web test:e2e",
		"lint": "pnpm --filter @dhc/web lint && pnpm --filter @dhc/api-client lint",
		"lint:fix": "pnpm --filter @dhc/web lint:fix && pnpm --filter @dhc/api-client lint:fix",
		"format": "pnpm --filter @dhc/web format",
		"format:check": "pnpm --filter @dhc/web format:check",
		"api-gen": "pnpm --filter @dhc/api-client api:generate"
	},
	"packageManager": "pnpm@11.21.0",
	"devDependencies": {
		"@discordjs/rest": "^2.6.3",
		"@oxlint/plugins": "1.78.0",
		"discord-api-types": "^0.38.53",
		"oxlint": "1.78.0"
	}
}
