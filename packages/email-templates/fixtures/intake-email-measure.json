      "expectedHtml": "<p>xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</p><p><br></p><p>Dublin HEMA Club</p>",
      "expectedLength": 81,
      "fits": true
    },
