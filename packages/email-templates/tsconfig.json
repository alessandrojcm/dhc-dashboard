{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "emails/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
