{
	"name": "@dhc/email-templates",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "email dev --dir emails",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt ./emails ./src ./test",
		"format:check": "oxfmt --check ./emails ./src ./test",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-email": "^6.9.1"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.78.0",
		"@react-email/ui": "^6.9.2",
		"@types/node": "^24.3.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"oxfmt": "^0.60.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^5.9.3",
		"vitest": "^4.1.7"
	}
}
